DATABASE_URL=sqlite+aiosqlite:///./botdb.sqlite
REDIS_URL=redis://localhost:6379
SECRET_KEY=change_me_to_a_secure_random_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=admin123

# Webshare (webshare.io) - the one paid proxy source wired up. Without a key its
# fetcher contributes nothing and the Proxies page says so; the free sources
# carry on regardless. Dashboard -> API -> Keys.
WEBSHARE_API_KEY=

# Webshare rotating ("backbone") endpoint - one hostname, a different exit IP per
# connection, authenticated with the proxy username/password from
# Dashboard -> Proxy -> Connection. Needs no API key, and works alongside one.
WEBSHARE_PROXY_HOST=p.webshare.io
WEBSHARE_PROXY_PORT=80
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
