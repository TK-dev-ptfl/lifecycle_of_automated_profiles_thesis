# Feed lab configuration. Copy to .env and fill in; .env is gitignored.
#
#   cp .env.example .env
#   node server.mjs
#
# Real environment variables take precedence, so a one-off override still works:
#   PORT=9000 node server.mjs

# reCAPTCHA v3 keys, from https://www.google.com/recaptcha/admin/create
# ("Score based (v3)"). Add localhost as an allowed domain. Leave both blank and
# the panel simply shows reCAPTCHA as "Not configured" - the behaviour and
# fingerprint checks run regardless, since they are entirely in-page.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Where the lab listens. Loopback by default so it is not exposed to your
# network; set HOST=0.0.0.0 only if you want to open it from another device.
HOST=127.0.0.1
PORT=8080
