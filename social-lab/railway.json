{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/social-lab/**"]
  },
  "deploy": {
    "healthcheckPath": "/api/config",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "drainingSeconds": 30
  }
}
