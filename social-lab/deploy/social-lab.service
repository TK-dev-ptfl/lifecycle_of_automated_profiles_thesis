# systemd unit for Social Lab. Install: see deploy/DEPLOY.md, step 7.
#   sudo cp deploy/social-lab.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now social-lab
[Unit]
Description=Social Lab study site
After=network-online.target
Wants=network-online.target

[Service]
User=sociallab
Group=sociallab
WorkingDirectory=/opt/social-lab
ExecStart=/usr/bin/node server/server.mjs
Restart=always
RestartSec=3
# Ports 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# The app can write only its data folder; the code, certificates and the rest
# of the system are read-only to it.
ProtectSystem=strict
ReadWritePaths=/opt/social-lab/data
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
