# Social Lab configuration. Copy to .env (gitignored). Real environment
# variables override this file.

# --- who runs the study: shown on the consent page. Required unless DEV=1. ---
STUDY_RESEARCHER=Tomas Knepp
STUDY_INSTITUTION=Comenius University Bratislava, Faculty of Mathematics, Physics and Informatics
STUDY_CONTACT=

# --- server ---
HOST=127.0.0.1
PORT=8090
DATA_DIR=data
# DEV=1 relaxes the contact requirement and the per-network session limit.
DEV=

# TLS terminated by this server: needed for TLS fingerprints (JA4/JA3).
# Behind a reverse proxy (nginx, Cloudflare) leave these empty and set TRUST_PROXY=1.
TLS_CERT=
TLS_KEY=
# With TLS on 443, also redirect plain HTTP from this port (e.g. 80).
HTTP_REDIRECT_PORT=
TRUST_PROXY=

# --- reCAPTCHA v3 (score based): https://www.google.com/recaptcha/admin/create ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# --- optional signals ---
# Contacts a Google STUN server; stores only whether WebRTC's address matches.
WEBRTC_CHECK=0
# Network type of the visitor's address via ip-api.com (free tier, non-commercial).
IP_LOOKUP=1

# --- access ---
# Bearer token for /admin/* (list and download sessions). Long and random.
ADMIN_TOKEN=
# Secret that bot runs present (?cohort=<label>&key=<COHORT_KEY>) to label their
# sessions as ground truth. Without it every session is labelled "human".
COHORT_KEY=

# --- storage off the server (hosts without a persistent disk, e.g. Railway) ---
# Private GitHub repository that receives each finished session, encrypted.
# Leave empty to keep sessions on local disk. See deploy/DEPLOY_RAILWAY.md.
DATA_REPO=
# Fine-grained token: only that repository, Contents: read and write.
DATA_REPO_TOKEN=
DATA_REPO_BRANCH=main
# One-line public key printed by `npm run keygen` (the private key stays on your PC).
DATA_PUBLIC_KEY=
# A session with no activity for this long is treated as abandoned and uploaded.
IDLE_MINUTES=30

# --- limits ---
MAX_SESSION_MB=60
MAX_SESSIONS_PER_IP_DAY=10
